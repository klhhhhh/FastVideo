"""Validate real packed H3 masks and export the offline experiment contract.

Missing, duplicate, mismatched or rank-disagreeing records are fatal. Conversion
writes into a staging directory and publishes only after all prompts validate.
Use --prompts 1 for a pilot; the full experiment consumers require ten prompts.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import platform
import shutil
import subprocess
import time

import numpy as np
import torch


def require(condition, message):
    if not condition:
        raise ValueError(message)


def sha256(path):
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()


def read_prompt(source, prompt, steps=4, layers=50, heads=56, video_tiles=40):
    trace = source / f'prompt_{prompt:02d}' / 'trace'
    samples = list(trace.glob('samples/*/sample.json'))
    layouts = list(trace.glob('layouts/*.pt'))
    require(len(samples) == len(layouts) == 1, f'Prompt {prompt}: need exactly one sample and layout')
    sample = json.loads(samples[0].read_text())
    require(sample.get('complete') is True, f'Prompt {prompt}: incomplete sample')
    layout = torch.load(layouts[0], weights_only=True, map_location='cpu')
    sizes = layout['variable_block_sizes'].numpy().astype(np.int64)
    ids = layout['packed_token_to_tile'].numpy().astype(np.int64)
    positions = layout['position_ids'].numpy()
    prefix = int(layout['num_prefix_tiles'])
    modalities = np.asarray(layout['tile_modalities'])
    video = np.flatnonzero(modalities == 'video')
    require(len(video) == video_tiles and np.array_equal(video, np.arange(prefix, len(sizes))),
            f'Prompt {prompt}: unsupported video tile geometry')
    require(positions.shape == (len(ids), 3), 'Invalid position shape')
    require(len(ids) == int(sizes.sum()) and np.all((sizes > 0) & (sizes <= 64)), 'Invalid tile sizes')
    require(len(ids) > 0 and ids.min() >= 0 and ids.max() < len(sizes), 'Invalid tile index')
    require(np.array_equal(np.bincount(ids, minlength=len(sizes)), sizes), 'Token/tile counts disagree')
    require(np.all(np.isin(modalities[:prefix], ['text','audio'])), 'Unexpected prefix modality')
    mins = np.array([positions[ids == v].min(0) for v in video])
    maxs = np.array([positions[ids == v].max(0) for v in video])
    coords = np.stack([np.unique(mins[:, axis], return_inverse=True)[1] for axis in range(3)], axis=1)
    require(len(np.unique(coords, axis=0)) == video_tiles, 'Video tile coordinates are not unique')
    paths = sorted(trace.glob('samples/*/rank_*/*.pt'))
    require(len(paths) == steps * layers, f'Prompt {prompt}: expected {steps*layers} records, found {len(paths)}')
    masks = np.empty((steps, layers, heads, video_tiles, video_tiles), dtype=bool)
    seen, manifest = set(), []
    for path in paths:
        record = torch.load(path, weights_only=True, map_location='cpu')
        require(record['encoding'] == 'packed_bool' and record['bitorder'] in ['little','big'], 'Unknown encoding')
        require(record['layout_id'] == layout['layout_id'], 'Record/layout ID mismatch')
        require(record['global_head_ids'] == list(range(heads)), 'Missing or reordered global heads')
        require(record['head_dim'] == 128 and record['element_size'] == 2, 'Expected BF16 H3 head geometry')
        require(record['vsa_mode'] == 'exempt' and not record['selection_is_dense'] and not record['dense_override'],
                'Unexpected dense override or selector mode')
        require(record['call_id'] == 0 and record['forward_id'] == record['step_id'], 'Unexpected forward/call ID')
        key = (int(record['step_id']), int(record['layer_id']))
        require(0 <= key[0] < steps and 0 <= key[1] < layers and key not in seen, f'Invalid/duplicate record {key}')
        seen.add(key)
        shape = tuple(record['mask_shape'])
        require(shape == (1,heads,len(sizes),len(sizes)), 'Mask shape/layout mismatch')
        bits = record['mask_bits'].numpy()
        require(bits.dtype == np.uint8 and bits.size == (np.prod(shape)+7)//8, 'Packed mask byte size mismatch')
        if 'rank_agreement_sha256' in record:
            digest = hashlib.sha256(bits.tobytes()).hexdigest()
            require(all(item == digest for item in record['rank_agreement_sha256']), 'Cross-rank mask disagreement')
        mask = np.unpackbits(bits, bitorder=record['bitorder'])[:np.prod(shape)].reshape(shape)[0].astype(bool)
        require(mask[:, :prefix, :].all() and mask[:, :, :prefix].all(), 'Exempt prefix dense rule violated')
        video_mask = mask[:, prefix:, prefix:]
        require(np.all(video_mask.sum(-1) == 4), 'Expected exactly four selected video KV tiles per query')
        masks[key] = video_mask
        manifest.append(dict(path=str(path),bytes=path.stat().st_size,sha256=sha256(path),
                             prompt=prompt,step=key[0],layer=key[1]))
    require(seen == {(s,l) for s in range(steps) for l in range(layers)}, 'Incomplete step/layer coverage')
    for path in [samples[0], layouts[0]]:
        manifest.append(dict(path=str(path),bytes=path.stat().st_size,sha256=sha256(path),prompt=prompt))
    return masks, dict(sizes=sizes,packed_token_to_tile=ids,coords=coords,raw_position_min=mins,
                       raw_position_max=maxs,video_indices=video,prefix=prefix), sample, manifest


def convert(source, output, prompts=10, steps=4, layers=50, heads=56, video_tiles=40):
    started = time.time()
    require(not output.exists(), f'Output already exists: {output}')
    staging = output.with_name(output.name + '.incomplete')
    require(not staging.exists(), f'Staging output already exists: {staging}')
    staging.mkdir(parents=True)
    try:
        mapped = np.lib.format.open_memmap(staging/'video_masks.npy', mode='w+', dtype=np.bool_,
                                           shape=(prompts,steps,layers,heads,video_tiles,video_tiles))
        reference, reference_sample, samples, manifest = None, None, [], []
        for prompt in range(prompts):
            masks, layout, sample, files = read_prompt(source,prompt,steps,layers,heads,video_tiles)
            geometry = np.concatenate([layout['coords'],layout['sizes'][layout['video_indices'],None]],axis=1)
            signature = {k:sample[k] for k in ['model','seed','video_sigmas','audio_sigmas','video_timesteps','audio_timesteps']}
            if reference is None:
                reference, reference_sample = geometry, signature
            require(np.array_equal(reference,geometry), 'Video geometry differs across prompts')
            require(signature == reference_sample, 'Checkpoint, seed or actual schedule differs across prompts')
            require(len(signature['video_timesteps']) == len(signature['audio_timesteps']) == steps,
                    'Actual forward schedule does not match requested capture')
            mapped[prompt] = masks
            np.savez_compressed(staging/f'layout_{prompt:02d}.npz', **layout)
            samples.append(sample)
            manifest.extend(files)
            print('VALIDATED',prompt,'records',steps*layers,flush=True)
        mapped.flush()
        del mapped
        for path in sorted(source.glob('*config*.json')):
            manifest.append(dict(path=str(path),bytes=path.stat().st_size,sha256=sha256(path)))
        provenance = dict(schema='h3-real-mask-trace-v1',source=str(source),samples=samples,
            train_prompts=list(range(8)) if prompts == 10 else [],test_prompts=[8,9] if prompts == 10 else [],
            pilot=prompts != 10,mask_axes=['prompt','step','layer','head','q_video_tile','kv_video_tile'],
            actual_gpus=2,mode='real two-GPU inference masks, rank-agreed and rank-zero deduplicated; new dataset',
            shape=[prompts,steps,layers,heads,video_tiles,video_tiles],python=platform.python_version(),
            torch=torch.__version__,numpy=np.__version__,seconds=time.time()-started,
            current_revision=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),
            converter_sha256=sha256(Path(__file__)),complete=True)
        (staging/'provenance.json').write_text(json.dumps(provenance,indent=2))
        (staging/'source_manifest.json').write_text(json.dumps(manifest,indent=2))
        staging.rename(output)
    except BaseException:
        shutil.rmtree(staging)
        raise


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--prompts', type=int, default=10)
    args = parser.parse_args()
    convert(args.source,args.output,prompts=args.prompts)
