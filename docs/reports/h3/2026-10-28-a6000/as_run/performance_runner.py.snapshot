"""Real two-GPU H3 mask capture and fixed-layout generation experiments.

Hooks are process-local and installed in spawned workers. Capture uses the actual
post-selector mask, verifies rank agreement, and writes only rank zero's copy.
Run with the project's working Python environment (including H3 dependencies).
"""
from __future__ import annotations

import argparse
import copy
import hashlib
import json
import math
from pathlib import Path
import subprocess
import time


def arguments():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--model', required=True)
    p.add_argument('--prompts', type=Path, required=True)
    p.add_argument('--output', type=Path, required=True)
    p.add_argument('--conditioning', type=Path, required=True)
    p.add_argument('--capture', action='store_true')
    p.add_argument('--start', type=int, default=0)
    p.add_argument('--count', type=int, default=1)
    p.add_argument('--seed', type=int, default=1000)
    p.add_argument('--repeats', type=int, default=1)
    p.add_argument('--layout', type=Path)
    p.add_argument('--transport', choices=['ring', 'demand'], default='ring')
    p.add_argument('--metrics', type=Path)
    p.add_argument('--profile', action='store_true')
    return p.parse_args()


# Spawn executes this module before the worker starts; install the same hooks
# in each interpreter. No generation or filesystem mutation happens on import.
OPTIONS = arguments()
PROMPTS = json.loads(OPTIONS.prompts.read_text())
if len(PROMPTS) != len(set(PROMPTS)):
    raise ValueError('Prompt list must not contain duplicates')

import numpy as np
import torch
import torch.distributed as dist
from fastvideo import VideoGenerator, envs
from fastvideo.api import (CompileConfig, EngineConfig, GenerationRequest, GeneratorConfig, OffloadConfig,
                           OutputConfig, ParallelismConfig, PipelineSelection, SamplingConfig)
import fastvideo.attention.h3_ring_attention as ring
from fastvideo.fastvideo_args import set_current_fastvideo_args
from fastvideo.forward_context import get_forward_context
from fastvideo.models.dits.minimax_h3 import MiniMaxH3Transformer3DModel
from fastvideo.models.loader.component_loader import TextEncoderLoader
from fastvideo.pipelines.basic.minimax_h3.stages.minimax_h3_conditioning import (
    MINIMAX_H3_TEXT_TOKEN_TAGS_KEY, MiniMaxH3ConditioningStage)
from fastvideo.pipelines.basic.minimax_h3.stages.minimax_h3_denoising import MiniMaxH3DenoisingStage

STATE = {}
LOAD_ENCODER = TextEncoderLoader.load
CONDITION = MiniMaxH3ConditioningStage.forward
DENOISE = MiniMaxH3DenoisingStage.forward
MODEL_FORWARD = MiniMaxH3Transformer3DModel.forward
RING_FORWARD = ring.H3RingAttention.forward
BUILD_MASK = ring._build_block_mask


def cache_path(prompt):
    digest = hashlib.sha256(prompt.encode()).hexdigest()[:20]
    return OPTIONS.conditioning / (digest + '.pt')


def load_encoder(self, model_path, args):
    if dist.get_rank() != 0:
        return torch.nn.Identity()
    with envs.FASTVIDEO_H3_ENCODER_LAYERWISE.override(True):
        return LOAD_ENCODER(self, model_path, args)


@torch.no_grad()
def condition(self, batch, args):
    device = torch.device('cuda', torch.cuda.current_device())
    if dist.get_rank() == 0:
        # Encode all missing prompts while the one real text encoder is loaded.
        # It is released by the existing lazy-module lifecycle after this stage.
        OPTIONS.conditioning.mkdir(parents=True, exist_ok=True)
        for prompt in PROMPTS:
            path = cache_path(prompt)
            if not path.exists():
                temporary = copy.copy(batch)
                temporary.extra = dict(batch.extra)
                temporary.prompt = prompt
                temporary.prompt_embeds = []
                temporary = CONDITION(self, temporary, args)
                torch.save(dict(prompt=prompt, model=OPTIONS.model,
                                embeds=temporary.prompt_embeds[0].cpu(),
                                tags=temporary.extra[MINIMAX_H3_TEXT_TOKEN_TAGS_KEY].cpu()), path)
                print('CONDITIONING_CACHED', prompt, flush=True)
        saved = torch.load(cache_path(batch.prompt), weights_only=True, map_location=device)
        if saved['prompt'] != batch.prompt or saved['model'] != OPTIONS.model:
            raise ValueError('Conditioning provenance mismatch')
        embeds, tags = saved['embeds'], saved['tags']
        metadata = [(tuple(embeds.shape), embeds.dtype, tuple(tags.shape), tags.dtype)]
    else:
        metadata = [None]
    dist.broadcast_object_list(metadata, src=0)
    shape, dtype, tag_shape, tag_dtype = metadata[0]
    if dist.get_rank() != 0:
        embeds = torch.empty(shape, dtype=dtype, device=device)
        tags = torch.empty(tag_shape, dtype=tag_dtype, device=device)
    embeds, tags = embeds.contiguous(), tags.contiguous()
    dist.broadcast(embeds, src=0)
    dist.broadcast(tags, src=0)
    batch.prompt_embeds = [embeds]
    batch.extra[MINIMAX_H3_TEXT_TOKEN_TAGS_KEY] = tags.cpu()
    return batch


def save_layout(kwargs):
    meta = get_forward_context().attn_metadata
    sizes = meta.variable_block_sizes.cpu()
    ids = (meta.untile_combined_index // meta.tile_elems).cpu()
    positions = kwargs['position_ids'].detach().cpu()
    if positions.ndim == 3 and positions.shape[0] == 1:
        positions = positions[0]
    if positions.shape != (len(ids), 3):
        raise ValueError(f'Unexpected position geometry: {positions.shape}')
    segments = meta.packed_token_segments
    modalities = []
    dense_index = 0
    for segment in segments:
        if isinstance(segment, int):
            modalities += [('text' if dense_index == 0 else 'audio')] * math.ceil(segment / meta.tile_elems)
            dense_index += 1
    modalities += ['video'] * meta.num_video_tiles
    if len(modalities) != len(sizes) or len(ids) != int(sizes.sum()):
        raise ValueError('Invalid captured layout geometry')
    digest = hashlib.sha256(sizes.numpy().tobytes() + ids.numpy().tobytes() + positions.numpy().tobytes()).hexdigest()
    STATE['layout_id'] = digest
    STATE['meta'] = meta
    if dist.get_rank() == 0:
        path = STATE['trace'] / 'layouts' / (digest + '.pt')
        path.parent.mkdir(parents=True, exist_ok=True)
        torch.save(dict(layout_id=digest, variable_block_sizes=sizes,
                        packed_token_to_tile=ids, position_ids=positions,
                        tile_modalities=modalities, num_prefix_tiles=meta.num_prefix_tiles,
                        tile_shape=[4, 4, 4], packed_segments=segments), path)


def model_forward(self, *args, **kwargs):
    for block in self.transformer_blocks:
        delegate = block.attn.distributed_attention
        if not isinstance(delegate, ring.H3RingAttention):
            raise ValueError('Main block did not select sparse Ring')
        if (delegate.layout is None) != (OPTIONS.layout is None):
            raise ValueError('Requested layout was not applied during lazy loading')
        if delegate.transport != OPTIONS.transport or not delegate.persistent or delegate.schedule != 'fixed':
            raise ValueError('Requested fixed persistent transport was not applied')
        if delegate.prior is not None:
            raise ValueError('Prefetch must remain disabled')
    if OPTIONS.capture and 'layout_id' not in STATE:
        save_layout(kwargs)
    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
    start.record()
    result = MODEL_FORWARD(self, *args, **kwargs)
    end.record()
    STATE['events'].append((start, end))
    return result


def ring_forward(self, *args, **kwargs):
    STATE['layer'] = self.attn_impl.layer_idx
    return RING_FORWARD(self, *args, **kwargs)


def build_mask(*args, **kwargs):
    mask = BUILD_MASK(*args, **kwargs)
    if not OPTIONS.capture:
        return mask
    context = get_forward_context()
    meta = context.attn_metadata
    key = (context.current_timestep, STATE['layer'])
    if key in STATE['seen']:
        raise ValueError(f'Duplicate mask record {key}')
    STATE['seen'].add(key)
    raw = mask.detach().cpu().numpy()
    bits = np.packbits(raw.reshape(-1), bitorder='little')
    digest = hashlib.sha256(bits.tobytes()).hexdigest()
    digests = [None] * dist.get_world_size()
    dist.all_gather_object(digests, digest)
    if len(set(digests)) != 1:
        raise ValueError(f'Ranks disagree on global mask {key}: {digests}')
    if dist.get_rank() == 0:
        path = STATE['trace'] / 'samples' / 'sample_0' / 'rank_0'
        path.mkdir(parents=True, exist_ok=True)
        torch.save(dict(encoding='packed_bool', bitorder='little', mask_bits=torch.from_numpy(bits.copy()),
                        mask_shape=list(raw.shape), layout_id=STATE['layout_id'],
                        global_head_ids=list(range(raw.shape[1])), head_dim=128, element_size=2,
                        vsa_mode='exempt', selection_is_dense=bool(raw.all()),
                        dense_override=STATE['layer'] in meta.dense_layers,
                        dense_layers=list(meta.dense_layers), sparsity=meta.VSA_sparsity,
                        step_id=key[0], forward_id=key[0], layer_id=key[1], call_id=0,
                        rank_agreement_sha256=digests), path / f'step_{key[0]}_layer_{key[1]:02d}.pt')
    return mask


def denoise(self, batch, args):
    index = PROMPTS.index(batch.prompt)
    repeat = STATE.get('repeat', 0) + 1
    STATE.clear()
    STATE.update(repeat=repeat, trace=OPTIONS.output / f'prompt_{index:02d}' / 'trace', seen=set(), events=[])
    torch.cuda.synchronize()
    started = time.perf_counter()
    # Lazy transformer construction must see the run's layout/transport args.
    with set_current_fastvideo_args(args):
        if OPTIONS.profile:
            with torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CPU,
                                                   torch.profiler.ProfilerActivity.CUDA]) as profiler:
                result = DENOISE(self, batch, args)
                torch.cuda.synchronize()
            profiler.export_chrome_trace(str(OPTIONS.output / f'profile_rank_{dist.get_rank()}.json'))
        else:
            result = DENOISE(self, batch, args)
    torch.cuda.synchronize()
    record = dict(prompt_id=index, repeat=repeat, rank=dist.get_rank(),
                  denoising_stage_seconds=time.perf_counter() - started,
                  transformer_cuda_ms=[a.elapsed_time(b) for a,b in STATE['events']],
                  video_timesteps=self.scheduler.timesteps.tolist(), audio_timesteps=self.audio_scheduler.timesteps.tolist(),
                  video_sigmas=self.scheduler.sigmas.tolist(), audio_sigmas=self.audio_scheduler.sigmas.tolist(),
                  peak_allocated_mib=torch.cuda.max_memory_allocated() / 2**20)
    if len(STATE['events']) != 4:
        raise ValueError('Expected exactly four real transformer forwards')
    if not torch.isfinite(result.latents).all() or not torch.isfinite(result.audio_latents).all():
        raise ValueError('Nonfinite final latent')
    if dist.get_rank() == 0:
        torch.save(dict(video=result.latents.cpu(), audio=result.audio_latents.cpu()),
                   OPTIONS.output / f'latents_p{index:02d}_r{repeat:02d}.pt')
    with (OPTIONS.output / f'measurements_rank_{dist.get_rank()}.jsonl').open('a') as stream:
        stream.write(json.dumps(record) + '\n')
    if OPTIONS.capture:
        expected = {(s,l) for s in range(4) for l in range(50)}
        if STATE['seen'] != expected:
            raise ValueError(f'Incomplete masks: {len(STATE["seen"])}')
        if dist.get_rank() == 0:
            path = STATE['trace'] / 'samples' / 'sample_0' / 'sample.json'
            path.write_text(json.dumps(dict(complete=True, prompt=batch.prompt, seed=OPTIONS.seed,
                                           model=OPTIONS.model, actual_gpus=2, global_mask_rank_deduplication=True,
                                           records=200, **record), indent=2))
    return result


TextEncoderLoader.load = load_encoder
MiniMaxH3ConditioningStage.forward = condition
MiniMaxH3DenoisingStage.forward = denoise
MiniMaxH3Transformer3DModel.forward = model_forward
ring.H3RingAttention.forward = ring_forward
ring._build_block_mask = build_mask


def main():
    OPTIONS.output.mkdir(parents=True, exist_ok=True)
    if (OPTIONS.output / 'run_config.json').exists():
        raise ValueError('Use a fresh output directory; never mix capture/performance runs')
    config = vars(OPTIONS).copy()
    config.update(height=256, width=256, num_frames=124, sigma_grid_points=5, transformer_forwards=4,
                  sparsity=0.9, tile_size=64, vsa_mode='exempt', actual_gpus=2, schedule='fixed', persistent=True,
                  prompts=PROMPTS, train_prompts=list(range(8)), test_prompts=[8,9],
                  git_head=subprocess.check_output(['git','rev-parse','HEAD'], text=True).strip(),
                  git_diff_sha256=hashlib.sha256(subprocess.check_output(['git','diff'])).hexdigest(),
                  source_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
    for name in ['fastvideo_inference.json', 'provenance.json', 'transformer/config.json']:
        path = Path(OPTIONS.model) / name
        config[name] = json.loads(path.read_text())
    (OPTIONS.output / 'run_config.json').write_text(json.dumps(config, indent=2, default=str))
    experimental = dict(attention_backend='VIDEO_SPARSE_ATTN_H3', ring_size=2,
                        h3_ring_transport=OPTIONS.transport, h3_ring_schedule='fixed', h3_ring_persistent=True,
                        VSA_sparsity=0.9, VSA_tile_size=64)
    if OPTIONS.layout:
        experimental['h3_ring_layout'] = str(OPTIONS.layout.resolve())
    if OPTIONS.metrics:
        experimental['h3_ring_metrics'] = str(OPTIONS.metrics.resolve())
    generator = VideoGenerator.from_config(GeneratorConfig(
        model_path=OPTIONS.model, pipeline=PipelineSelection(experimental=experimental),
        engine=EngineConfig(num_gpus=2, execution_backend='mp', use_fsdp_inference=True,
                            parallelism=ParallelismConfig(tp_size=1, sp_size=2),
                            offload=OffloadConfig(dit=False, dit_layerwise=False, text_encoder=True, vae=True,
                                                  pin_cpu_memory=False, lazy_module_load=True),
                            compile=CompileConfig(enabled=False, vae_enabled=False))))
    try:
        for index in range(OPTIONS.start, min(len(PROMPTS), OPTIONS.start + OPTIONS.count)):
            for repeat in range(OPTIONS.repeats):
                result = generator.generate(GenerationRequest(prompt=PROMPTS[index], negative_prompt='',
                    sampling=SamplingConfig(height=256,width=256,num_frames=124,fps=24,num_inference_steps=5,
                                            guidance_scale=1.,batch_cfg=False,seed=OPTIONS.seed),
                    output=OutputConfig(output_path=str(OPTIONS.output / f'video_p{index:02d}_r{repeat:02d}.mp4'),
                                        save_video=True,return_frames=False)))
                print('GENERATION_RESULT', json.dumps(dict(prompt_id=index,repeat=repeat,
                      generation_seconds=result.generation_time,peak_memory_mb=result.peak_memory_mb)), flush=True)
    finally:
        generator.shutdown()


if __name__ == '__main__':
    main()
